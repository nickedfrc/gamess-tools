#!/usr/bin/env python3
"""
dat2molden.py - Parse a GAMESS text punch (.dat) file to generate a Molden file.

Reads:
  - Atoms from .gms
  - Basis set + MO coefficients from .dat (text punch file, $VEC section)

Usage:
  dat2molden <jobname> [options]

Options:
  -o, --output FILE   Write the Molden file to FILE.
                      Default: <jobname>.molden next to the input.
  --title TEXT        [Title] line of the Molden file.
                      Default: 'Generated by dat2molden from <jobname>'.
  --charge Q          Total charge of the system, used for the default
                      occupancy count.  Default: 0.
  --mult M            Spin multiplicity, used for the default occupancy count.
                      Default: 1 (closed shell: 2 electrons per MO).
  --nocc N            Number of doubly occupied orbitals.  Overrides the value
                      derived from --charge/--mult.  Orbitals above N are marked
                      as empty.
  --occ 'O1 O2 ...'   Explicit per-orbital occupations, 1-based, e.g.
                      --occ '2 2 2 1 0'.  Overrides --nocc.  Orbitals not
                      listed keep the default occupation.
  -h, --help          Show this help.

  <jobname> may be given with or without the .gms/.dat extension, and may
  include a directory, e.g. 'runs/rastest'.

Examples:
  dat2molden rastest                          # rastest.gms + rastest.dat
  dat2molden rastest -o out/rastest.molden
  dat2molden rastest --charge -1 --mult 2     # open-shell anion
  dat2molden rastest --occ '2 2 2 1 0 0'
"""

import sys
import re
import os
import math

BOHR_TO_ANG = 0.52917721067

ANGULAR_L = {'S': 0, 'P': 1, 'D': 2, 'F': 3, 'G': 4, 'H': 5, 'L': 4}
CARTESIAN_DEGEN = {0: 1, 1: 3, 2: 6, 3: 10, 4: 15, 5: 21}
SPHERICAL_DEGEN = {0: 1, 1: 3, 2: 5, 3: 7, 4: 9, 5: 11}

ELEMENT_FULL_TO_SYMBOL = {
    'HYDROGEN': 'H',  'HELIUM': 'He', 'LITHIUM': 'Li', 'BERYLLIUM': 'Be',
    'BORON': 'B',    'CARBON': 'C',  'NITROGEN': 'N',  'OXYGEN': 'O',
    'FLUORINE': 'F', 'NEON': 'Ne',   'SODIUM': 'Na',   'MAGNESIUM': 'Mg',
    'ALUMINUM': 'Al', 'SILICON': 'Si','PHOSPHORUS': 'P','SULFUR': 'S',
    'CHLORINE': 'Cl', 'ARGON': 'Ar',  'POTASSIUM': 'K', 'CALCIUM': 'Ca',
    'IRON': 'Fe',     'BROMINE': 'Br','IODINE': 'I',
}


def parse_atoms(lines):
    atoms = []
    in_section = False
    for line in lines:
        if 'COORDINATES (BOHR)' in line:
            in_section = True
            continue
        if in_section:
            if 'INTERNUCLEAR DISTANCES' in line or '------' in line:
                break
            parts = line.split()
            if len(parts) >= 5:
                try:
                    float(parts[-3])
                except ValueError:
                    continue
                element = ELEMENT_FULL_TO_SYMBOL.get(parts[0].upper(), parts[0].capitalize())
                charge = int(float(parts[1]))
                x = float(parts[-3]) * BOHR_TO_ANG
                y = float(parts[-2]) * BOHR_TO_ANG
                z = float(parts[-1]) * BOHR_TO_ANG
                atoms.append((element, charge, x, y, z))
    return atoms


def parse_dat(dat_path):
    shells = []
    current_atom_shells = []
    in_basis = True
    in_vec = False
    mos = {}
    nbf_cart = 0
    last_mo_label = -1
    mo_cycle = 0

    current_shell_l = None
    current_primitives = []

    with open(dat_path, 'r') as f:
        for line in f:
            stripped = line.rstrip('\n\r')
            check = stripped.lstrip()
            if not check:
                if in_basis:
                    if current_primitives and current_shell_l is not None:
                        current_atom_shells.append((current_shell_l, current_primitives))
                        nbf_cart += CARTESIAN_DEGEN[current_shell_l]
                        current_primitives = []
                        current_shell_l = None
                    if current_atom_shells:
                        shells.append(current_atom_shells)
                        current_atom_shells = []
                continue

            if check.startswith('$VEC'):
                if in_basis:
                    if current_primitives and current_shell_l is not None:
                        current_atom_shells.append((current_shell_l, current_primitives))
                        nbf_cart += CARTESIAN_DEGEN[current_shell_l]
                        current_primitives = []
                        current_shell_l = None
                    if current_atom_shells:
                        shells.append(current_atom_shells)
                        current_atom_shells = []
                in_basis = False
                in_vec = True
                continue

            if in_vec:
                if check.startswith('$END'):
                    break

                if len(stripped) < 8:
                    continue

                try:
                    raw_label = int(stripped[0:2].strip())
                except ValueError:
                    continue

                if raw_label < last_mo_label and last_mo_label > 90:
                    mo_cycle += 100
                last_mo_label = raw_label
                mo_idx = raw_label + mo_cycle

                for col in range(5):
                    start = 5 + col * 15
                    end = start + 15
                    if start >= len(stripped):
                        break
                    chunk = stripped[start:end].strip()
                    if chunk:
                        try:
                            val = float(chunk.replace('D', 'E'))
                            if mo_idx not in mos:
                                mos[mo_idx] = []
                            mos[mo_idx].append(val)
                        except ValueError:
                            pass
                continue

            if in_basis:
                shell_match = re.match(
                    r'\s*([SPDFGH])\s+(\d+)', stripped
                )
                if shell_match:
                    if current_primitives and current_shell_l is not None:
                        current_atom_shells.append((current_shell_l, current_primitives))
                        nbf_cart += CARTESIAN_DEGEN[current_shell_l]
                    current_shell_l = ANGULAR_L.get(shell_match.group(1), 0)
                    current_primitives = []
                    continue

                prim_match = re.match(
                    r'\s*(\d+)\s+([\d\.\-\+]+)\s+([\d\.\-\+]+)', stripped
                )
                if prim_match:
                    exponent = float(prim_match.group(2))
                    coeff = float(prim_match.group(3))
                    current_primitives.append((exponent, coeff))

        if in_basis and current_primitives and current_shell_l is not None:
            current_atom_shells.append((current_shell_l, current_primitives))
            nbf_cart += CARTESIAN_DEGEN[current_shell_l]
            current_primitives = []
            current_shell_l = None
        if in_basis and current_atom_shells:
            shells.append(current_atom_shells)
            current_atom_shells = []

    result_mos = [mos[k] for k in sorted(mos.keys())] if mos else []
    return shells, result_mos, nbf_cart


def fortran_d(val):
    if val == 0.0:
        return ' 0.0000000000D+00'
    exp = int(math.floor(math.log10(abs(val)))) + 1
    mant = val / (10.0 ** exp)
    if mant < 0:
        return f'{mant: 14.10f}D{exp:+03d}'
    else:
        return f' {mant: 13.10f}D{exp:+03d}'


L_LABEL = {0: 's', 1: 'p', 2: 'd', 3: 'f', 4: 'g', 5: 'h'}


def count_molden_bf(shells):
    n = 0
    for atom_shells in shells:
        for l_val, prims in atom_shells:
            n += SPHERICAL_DEGEN[l_val] if l_val >= 2 else CARTESIAN_DEGEN[l_val]
    return n


def write_gto_section(f, shells, atoms):
    f.write('[GTO]\n')
    atom_idx = 0
    for atom_shells in shells:
        atom_idx += 1
        f.write(f'  {atom_idx} 0\n')
        for l_val, prims in atom_shells:
            label = L_LABEL[l_val]
            f.write(f' {label}  {len(prims)}  1.00\n')
            for exp_val, coeff in prims:
                f.write(f'{fortran_d(exp_val)}{fortran_d(coeff)}\n')
        f.write('\n')


def usage(f=None):
    (f or sys.stdout).write(__doc__.lstrip('\n'))


def parse_cli(argv):
    """Return (options dict, error message or None, help requested)."""
    opts = {
        'target': None,
        'output': None,
        'title': None,
        'charge': 0,
        'mult': 1,
        'nocc': None,
        'occ': None,
    }
    positional = []
    unfilled = None

    for arg in argv:
        if unfilled is not None:
            opts[unfilled] = arg
            unfilled = None
            continue
        if arg in ('-h', '--help'):
            return opts, None, True
        if arg in ('-o', '--output'):
            unfilled = 'output'
        elif arg == '--title':
            unfilled = 'title'
        elif arg == '--charge':
            unfilled = 'charge'
        elif arg == '--mult':
            unfilled = 'mult'
        elif arg == '--nocc':
            unfilled = 'nocc'
        elif arg == '--occ':
            unfilled = 'occ'
        elif arg.startswith('-') and arg != '-':
            return opts, f'unknown option {arg!r}', False
        else:
            positional.append(arg)

    if unfilled is not None:
        return opts, f'option --{unfilled} needs a value', False
    if not positional:
        return opts, 'no <jobname> given', False
    if len(positional) > 1:
        return opts, f'unexpected extra argument {positional[1]!r}', False

    opts['target'] = positional[0]

    for key in ('charge', 'mult', 'nocc'):
        if opts[key] is None:
            continue
        try:
            opts[key] = int(opts[key])
        except ValueError:
            return opts, f'--{key} expects an integer, got {opts[key]!r}', False

    if opts['occ'] is not None:
        try:
            opts['occ'] = [float(v) for v in opts['occ'].split()]
        except ValueError:
            return opts, f'--occ expects numbers, got {opts["occ"]!r}', False

    return opts, None, False


def main():
    opts, error, help_wanted = parse_cli(sys.argv[1:])

    if help_wanted:
        usage()
        return 0
    if error:
        print(f'Error: {error}', file=sys.stderr)
        print(file=sys.stderr)
        usage(sys.stderr)
        return 2

    raw_target = opts['target']
    basename = raw_target
    if basename.endswith('.gms') or basename.endswith('.dat'):
        basename = os.path.splitext(os.path.basename(basename))[0]

    dirname = os.path.dirname(raw_target) if os.path.dirname(raw_target) else '.'
    gms_path = os.path.join(dirname, basename + '.gms')
    dat_path = os.path.join(dirname, basename + '.dat')

    output_file = opts['output'] or os.path.join(dirname, basename + '.molden')
    title = opts['title'] if opts['title'] is not None else f'Generated by dat2molden from {basename}'

    if not os.path.exists(gms_path):
        print(f"Error: {gms_path} not found", file=sys.stderr)
        return 1
    if not os.path.exists(dat_path):
        print(f"Error: {dat_path} not found", file=sys.stderr)
        return 1

    with open(gms_path, 'r') as f:
        gms_lines = f.readlines()

    print(f"Reading {gms_path} ({len(gms_lines)} lines)")

    atoms = parse_atoms(gms_lines)
    print(f"Found {len(atoms)} atoms")

    print(f"Reading basis set + $VEC from {dat_path}")
    shells, mos, nbf_cart = parse_dat(dat_path)
    print(f"Found {len(shells)} atom basis groups, {sum(len(s) for s in shells)} shells total")
    print(f"Cartesian basis functions: {nbf_cart}")

    if not mos:
        print("ERROR: No $VEC section found in .dat", file=sys.stderr)
        return 1

    norb = len(mos)
    nbf_per_mo = len(mos[0]) if norb > 0 else 0
    print(f"MO coefficients: {norb} orbitals x {nbf_per_mo} basis functions")

    # Default occupation: closed shell from the nuclear charge, unless the user
    # asked for something else.
    nelec = sum(a[1] for a in atoms) - opts['charge']
    default_nocc = max(0, (nelec + (opts['mult'] - 1)) // 2)

    if opts['occ'] is not None:
        occ_values = [opts['occ'][i] if i < len(opts['occ']) else 0.0 for i in range(norb)]
        occ_desc = 'from --occ'
    else:
        nocc = opts['nocc'] if opts['nocc'] is not None else default_nocc
        nocc = max(0, min(nocc, norb))
        occ_values = [2.0 if i < nocc else 0.0 for i in range(norb)]
        occ_desc = f'{nocc} doubly occupied'
        if opts['nocc'] is None:
            occ_desc += f' (auto from {nelec} electrons)'

    print(f"Occupations: {occ_desc}")

    nbf_molden = count_molden_bf(shells)

    with open(output_file, 'w') as f:
        f.write('[Molden Format]\n')
        f.write('[Title]\n')
        f.write(f' {title}\n')
        f.write('\n')

        f.write('[Atoms] Angs\n')
        for i, (elem, charge, x, y, z) in enumerate(atoms, 1):
            f.write(f'{elem:<3s} {i:4d} {charge:3d}  {x:15.10f}  {y:15.10f}  {z:15.10f}\n')
        f.write('\n')

        if len(atoms) != len(shells):
            f.write(f'[Comment]\n')
            f.write(f' Warning: {len(atoms)} atoms but {len(shells)} basis groups\n')
            f.write('\n')

        write_gto_section(f, shells, atoms)

        f.write('[MO]\n')
        for mo_idx, coeffs in enumerate(mos, 1):
            occ = occ_values[mo_idx - 1]
            f.write(f' Sym= 1\n')
            f.write(f' Ene=    0.000000\n')
            f.write(f' Spin= Alpha\n')
            f.write(f' Occup=   {occ:12.6f}\n')
            for bf_idx, coeff in enumerate(coeffs, 1):
                f.write(f' {bf_idx:5d}  {coeff:14.11f}\n')

    print(f"\nMolden file written to: {output_file}")
    print(f"[GTO] shells: {sum(len(s) for s in shells)}  [MO] size: {norb} x {nbf_per_mo}")

    return 0


if __name__ == '__main__':
    sys.exit(main())